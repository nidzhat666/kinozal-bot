TELEGRAM_BOT_TOKEN=
KINOZAL_USERNAME=
KINOZAL_PASSWORD=
LOCAL_BUILD=1
QBT_HOST=http://localhost
QBT_USERNAME=admin
QBT_PASSWORD=112233
QBT_PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Webhook configuration
BASE_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8000

# =============================================================================
# Transcoding Configuration
# =============================================================================

# Enable/disable transcoding service
TRANSCODE_ENABLED=false

# Number of concurrent FFmpeg workers
TRANSCODE_WORKERS=3

# API token for qBittorrent webhook (optional, leave empty to disable auth)
TRANSCODE_API_TOKEN=

# Paths to scan for videos (comma-separated)
# Example: /media/movies,/media/series
TRANSCODE_SCAN_PATHS=

# Allowed root paths for enqueue API (security, comma-separated)
# Only files within these roots can be transcoded
TRANSCODE_ALLOWED_ROOTS=

# Scan interval in hours
TRANSCODE_SCAN_INTERVAL_HOURS=6

# Lease timeout in minutes (job is considered stuck if no progress)
TRANSCODE_LEASE_MINUTES=60

# Maximum retry attempts before moving to DLQ
TRANSCODE_MAX_ATTEMPTS=3

# Kill FFmpeg if no progress for this many minutes
TRANSCODE_PROGRESS_TIMEOUT_MINUTES=10

# Replace original file with transcoded version
# If false, creates new file with suffix
TRANSCODE_REPLACE_ORIGINAL=false

# Suffix for transcoded files (when not replacing original)
TRANSCODE_OUTPUT_SUFFIX=.optimized

# Keep backup files for this many hours (when replacing original)
TRANSCODE_KEEP_BACKUP_HOURS=72

# Number of GPU slots (0 = CPU only)
# Used for NVENC profiles to limit concurrent GPU encoding
TRANSCODE_GPU_SLOTS=0

# Folder resolver default mode: movie, series, auto
TRANSCODE_DEFAULT_MODE=auto

# Maximum files per enqueue request
TRANSCODE_MAX_FILES_PER_ENQUEUE=50

# =============================================================================
# FFmpeg Configuration
# =============================================================================

# FFmpeg profile (from ffmpeg_profiles.py):
#   nvenc_hevc_optimized - NVENC HEVC with stereo fallback audio (recommended for GPU)
#   nvenc_hevc_4k        - NVENC HEVC optimized for 4K content
#   nvenc_hevc_fast      - Fast NVENC encoding (no stereo fallback)
#   cpu_hevc_medium      - CPU x265 encoding (no GPU required)
#   audio_only           - Copy video, only create stereo fallback audio
FFMPEG_PROFILE=nvenc_hevc_optimized

# =============================================================================
# qBittorrent Webhook Setup
# =============================================================================
# In qBittorrent: Settings -> Downloads -> "Run external program on torrent finished"
# Set command to:
#
# curl -X POST http://YOUR_HOST:8000/transcode/enqueue \
#   -H "Content-Type: application/json" \
#   -H "X-Transcode-Token: YOUR_TOKEN" \
#   -d '{"file_path":"%F","torrent_hash":"%I","torrent_name":"%N"}'
#
# Variables:
#   %F = Content path (file or folder)
#   %I = Torrent hash
#   %N = Torrent name
